{
  "name": "googlemaps",
  "version": "2025.3.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production @servoy/googlemaps",
    "build_debug": "ng build @servoy/googlemaps --watch",
    "build_debug_nowatch": "ng build @servoy/googlemaps --watch=false",
    "make_release": "ng build --configuration production @servoy/googlemaps && node scripts/build.js",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "lint": "ng lint",
    "cy:open": "cypress open",
    "cy:run": "cypress run --config video=false --component --browser chrome",
    "cy:run_spec": "cypress run --config video=false --component --browser chrome --headed --no-exit --spec "
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@googlemaps/markerclusterer": "2.6.2",
    "@servoy/public": "2026.9.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler": "^22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "3.65.5",
    "@types/luxon": "3.7.4",
    "@types/node": "^26.2.0",
    "@types/supercluster": "^7.1.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "adm-zip": "0.6.0",
    "angular-eslint": "^22.1.0",
    "css-loader": "^7.1.4",
    "cypress": "^15.21.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-only-warn": "1.2.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "ng-packagr": "22.1.1",
    "style-loader": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
