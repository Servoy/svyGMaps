{
  "name": "googlemaps",
  "version": "2026.9.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production @servoy/googlemaps",
    "build_debug": "ng build @servoy/googlemaps --watch",
    "build_debug_nowatch": "ng build @servoy/googlemaps --watch=false",
    "make_release": "ng build --configuration production @servoy/googlemaps && node scripts/build.js",
    "test": "ng test --no-watch",
    "test:watch": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@googlemaps/markerclusterer": "2.6.2",
    "@servoy/public": "2026.9.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "^22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "3.66.0",
    "@types/luxon": "3.7.5",
    "@types/node": "^26.4.0",
    "@types/supercluster": "^7.1.3",
    "adm-zip": "0.6.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.10",
    "ng-packagr": "22.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
